EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=super_questions
TOP_K=5
EVALUATION_DEPTH=20
EMBEDDING_BATCH_SIZE=64

# Retrieval 결과를 답변 생성에 사용하는 최소 RAG 데모 설정
LLM_PROVIDER=ollama

OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
OPENAI_MODEL=

RAG_COLLECTION=super_questions
RAG_TOP_K=3
RAG_MAX_DISTANCE=
RAG_DEBUG_PROMPT=false
RAG_DRY_RUN=false
RAG_RETRIEVAL_STRATEGY=full
RAG_INTENT_MODEL_PATH=models/super_intent_classifier.joblib
RAG_INTENT_TOP_N=3
RAG_INTENT_FALLBACK=true
LLM_TIMEOUT_SECONDS=60

# 기본값 full은 기존 RAG 검색 동작을 그대로 유지합니다.
RAG_RETRIEVAL_STRATEGY=full
RAG_INTENT_MODEL_PATH=models/super_intent_classifier.joblib
RAG_INTENT_TOP_N=3
RAG_INTENT_FALLBACK=true
